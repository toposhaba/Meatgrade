{
  "expo": {
    "name": "Meatgrade",
    "slug": "meatgrade",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "meatgrade",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F0E9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.toposhaba.meatgrade"
    },
    "android": {
      "package": "com.toposhaba.meatgrade",
      "adaptiveIcon": {
        "backgroundColor": "#8A2B25",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Meatgrade photographs the ribeye face to suggest a marbling degree.",
          "photosPermission": "Meatgrade reads a ribeye photo from your library to suggest a marbling degree."
        }
      ]
    ]
  }
}
